{
  "name": "@fadymondy/nasaq-theme-sdk",
  "version": "0.1.0",
  "description": "Nasaq themes for any app: the catalog, CircleXO connect, and the Themes page.",
  "license": "MIT",
  "author": "Fady Mondy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadymondy/nasaq-theme-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@fadymondy/nasaq": ">=1.1.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@fadymondy/nasaq": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fadymondy/nasaq": "^1.1.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
